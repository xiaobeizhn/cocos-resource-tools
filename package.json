{
    "package_version": 2,
    "name": "resource-tools",
    "version": "2.0.0",
    "description": "Prefab 资源工具集：未使用资源清理 + 资源 Prefab 引用查询",
    "editor": ">=3.8.8",
    "main": "main.js",
    "scripts": {
        "test": "node --test test/*.test.js"
    },
    "panels": {
        "default": {
            "title": "Prefab 依赖清理",
            "type": "dockable",
            "main": "panels/cleaner.js",
            "size": {
                "min-width": 420,
                "min-height": 360,
                "width": 620,
                "height": 580
            }
        },
        "usage": {
            "title": "资源 Prefab 引用",
            "type": "dockable",
            "main": "panels/usage.js",
            "size": {
                "min-width": 420,
                "min-height": 300,
                "width": 620,
                "height": 520
            }
        }
    },
    "contributions": {
        "assets": {
            "menu": {
                "methods": "./assets-menu.js",
                "assetMenu": "onAssetMenu"
            }
        },
        "hierarchy": {
            "menu": {
                "methods": "./hierarchy-menu.js",
                "nodeMenu": "onNodeMenu"
            }
        },
        "scene": {
            "script": "./scene.js"
        },
        "messages": {
            "copy-node-path": { "methods": ["copyNodePath"] },
            "open-cleaner": { "methods": ["openCleaner"] },
            "get-pending-prefab": { "methods": ["getPendingPrefab"] },
            "apply-prefab-path": { "methods": ["default.applyPrefabPath"] },
            "query-unused-assets": { "methods": ["queryUnusedAssets"] },
            "delete-selected": { "methods": ["deleteSelected"] },
            "find-usages": { "methods": ["findUsages"] },
            "get-last-result": { "methods": ["getLastResult"] },
            "open-prefab": { "methods": ["openPrefab"] },
            "select-node": { "methods": ["selectNode"] },
            "render-result": { "methods": ["usage.renderResult"] },
            "select-node-failed": { "methods": ["usage.selectNodeFailed"] }
        }
    }
}
